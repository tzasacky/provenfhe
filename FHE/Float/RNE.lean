import Spec.DecryptBFV

/-!
# FHE.Float.RNE — a round-to-nearest-even binary64 arithmetic, and the decryption transcription against recorded library outputs   (UNTRUSTED)

`rne x` rounds a rational to the nearest binary64 value, ties to even, in the normal range (no
subnormals, no overflow: every value below is far inside the normal range). `rneD` is the
uncontracted IEEE arithmetic of the build the recorded outputs come from (no FMA instruction in
the libraries): `s += a*b` is `rne (s + rne (a*b))`, `s -= a*b` is `rne (s - rne (a*b))`.

The `#guard`s run the TRUSTED transcription `Spec.DecryptBFV.decrypt1` with the tables it builds
itself (`Spec.DecryptBFV.tables`) on residue vectors recorded from the real OpenFHE v1.6.1
`Decrypt` (the phase residues per limb and the native coefficient the library returned) and check
the returned value bit for bit; the recorded outputs are those of the library's routine, which the
transcription reproduces. Vectors outside `decParamsOK?` are included; `decrypt1` is defined for
them anyway.
-/

namespace FHE.Float.RNE
open Spec.Float Spec.DecryptBFV

/-- `⌊log₂ a⌋` for a positive rational. -/
def ilog2 (a : ℚ) : ℤ :=
  let e0 : ℤ := (a.num.natAbs.log2 : ℤ) - (a.den.log2 : ℤ)
  if (2 : ℚ) ^ e0 ≤ a then e0 else e0 - 1

/-- Round a nonnegative rational to the nearest integer, ties to even. -/
def roundEven (m : ℚ) : ℤ :=
  let f := ⌊m⌋
  let r := m - f
  if r < 1 / 2 then f else if 1 / 2 < r then f + 1 else if f % 2 = 0 then f else f + 1

/-- `x` rounded to binary64 (53 significant bits), ties to even, normal range. -/
def rne (x : ℚ) : ℚ :=
  if x = 0 then 0 else
    let a := |x|
    let e : ℤ := ilog2 a
    let s : ℚ := (2 : ℚ) ^ (52 - e)
    let n := roundEven (a * s)
    (if x < 0 then -1 else 1) * (n : ℚ) / s

/-- The uncontracted IEEE binary64 arithmetic. -/
def rneA : Arith :=
  { ofNat := fun n => rne n, mul := fun a b => rne (a * b), div := fun a b => rne (a / b),
    add := fun a b => rne (a + b), fma := fun a b c => rne (a * b + c),
    mulAdd := fun s a b => rne (s + rne (a * b)) }

def rneD : ArithD :=
  { base := rneA, sub := fun a b => rne (a - b), fnma := fun a b c => rne (c - a * b),
    mulSub := fun s a b => rne (s - rne (a * b)) }

